{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-memory-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-16",
	"compatibility_flags": ["nodejs_compat"],

	// R2 bucket for file storage
	"r2_buckets": [
		{
			"binding": "MEMORY_BUCKET",
			"bucket_name": "agent-memory"
		}
	],

	// Durable Objects for embedding index
	"durable_objects": {
		"bindings": [
			{
				"name": "MEMORY_INDEX",
				"class_name": "MemoryIndex"
			}
		]
	},

	// Workers AI for embeddings
	"ai": {
		"binding": "AI"
	},

	// SQLite storage for Durable Objects
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MemoryIndex"]
		}
	],

	// Cron triggers for scheduled reflection
	"triggers": {
		"crons": ["0 6 * * *"] // Daily at 6am UTC (London morning)
	},

	// Reflection configuration
	//
	// Deep analysis runs one model with one focus per night (see
	// src/reflection/focus.ts). Whitespace hygiene is plain code, not a model.
	//
	// REFLECTION_MODEL: see the README "Choosing a reflection model" section
	// for the dry-run comparison that picked it. Kimi K2.6 is unusable here:
	// it emits tool calls as text inside reasoning_content, so they never
	// reach the parser.
	//
	// Optional: REFLECTION_FOCUS pins one focus id; REFLECTION_HYGIENE="false"
	// disables the whitespace tidy.
	"vars": {
		"REFLECTION_MODEL": "@cf/deepseek-ai/deepseek-v4-flash-0731",
		"USE_AGENTIC_REFLECTION": "true"
	}
}
